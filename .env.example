# Copy this file to .env.local for local development and configure real
# values in your hosting provider's dashboard (e.g. Vercel Project Settings ->
# Environment Variables) for staging/production. NEVER commit .env.local or
# real secrets to git.

# ----------------------------------------------------------------------------
# Site
# ----------------------------------------------------------------------------
# Canonical production URL, no trailing slash. Used for metadataBase, the
# sitemap, robots.txt, and Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://qaquad.com

# ----------------------------------------------------------------------------
# Hostinger SMTP Email Configuration
# ----------------------------------------------------------------------------
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@QAQuad.com
SMTP_PASS=your_hostinger_email_password
LEAD_NOTIFICATION_FROM_EMAIL=info@QAQuad.com
LEAD_NOTIFICATION_TO_EMAIL=info@QAQuad.com

# Resend / Webhook alternative (optional fallback)
RESEND_API_KEY=
LEAD_WEBHOOK_URL=

# ----------------------------------------------------------------------------
# Lead storage (optional, recommended before launch)
# If unset, leads are only emailed/logged, not persisted in a database.
# ----------------------------------------------------------------------------
DATABASE_URL=

# ----------------------------------------------------------------------------
# Spam protection (optional but recommended before launch)
# Cloudflare Turnstile is free and privacy-respecting. Leave blank to disable
# (the route still applies basic honeypot + rate-limit protection either way).
# ----------------------------------------------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ----------------------------------------------------------------------------
# Analytics (privacy-conscious). Leave blank to disable analytics entirely —
# the site works and looks identical either way.
# Plausible (https://plausible.io) is the reference integration used in
# src/components/analytics/Analytics.tsx.
# ----------------------------------------------------------------------------
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
